{
  "name": "@kaspacom/kcc20-tx-builder",
  "version": "0.2.2",
  "description": "Runtime-independent KCC20 covenant transaction and PSKT construction primitives.",
  "license": "Apache-2.0",
  "author": "KaspaCom",
  "homepage": "https://github.com/KASPACOM/kcc20-tx-builder#readme",
  "bugs": {
    "url": "https://github.com/KASPACOM/kcc20-tx-builder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KASPACOM/kcc20-tx-builder.git"
  },
  "keywords": [
    "kaspa",
    "kcc20",
    "covenants",
    "pskt",
    "transactions"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/cjs/*"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./artifacts/*": "./artifacts/*",
    "./package.json": "./package.json",
    "./*": {
      "import": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "require": {
        "types": "./dist/cjs/*.d.ts",
        "default": "./dist/cjs/*.js"
      }
    }
  },
  "files": [
    "dist",
    "index.d.ts",
    "src",
    "artifacts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run build && node test/smoke.mjs && node test/cjs-smoke.cjs",
    "prepack": "npm test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0"
  }
}

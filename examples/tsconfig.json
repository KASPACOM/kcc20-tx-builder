{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "shared/**/*.ts",
    "backend/**/*.ts",
    "frontend/**/*.ts",
    "test/**/*.ts"
  ]
}
